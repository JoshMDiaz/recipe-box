# Local dev runs against the Firebase Emulator Suite (`pnpm dev`).
# A "demo-" project ID needs no real Firebase project and can never touch production.
VITE_FIREBASE_PROJECT_ID=demo-recipe-box
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-recipe-box.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-recipe-box.appspot.com
VITE_FIREBASE_APP_ID=demo-app-id
VITE_USE_FIREBASE_EMULATORS=true
