{
  "name": "recipe-box",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "concurrently -k -n db,web -c yellow,cyan \"pnpm:emulators\" \"pnpm:dev:web\"",
    "dev:web": "vite",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-recipe-box --import ./.emulator-data --export-on-exit",
    "build": "tsc -b && vite build",
    "deploy:rules": "firebase deploy --only firestore --project prod",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-recipe-box \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.103.3",
    "@tanstack/react-router": "^1.170.39",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.31.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
