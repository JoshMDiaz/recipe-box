rules_version = '2';

// Recipe photos only: images under 10 MB. Same no-auth caveat as firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {
    match /recipes/{recipeId}/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
  }
}
