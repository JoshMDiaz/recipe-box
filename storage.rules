rules_version = '2';

// Recipe photos, stored per user: images under 10 MB, readable and writable
// only by their owner. (Anyone holding a download URL can still fetch the
// image; that's how getDownloadURL works.)
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/recipes/{recipeId}/{fileName} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read, delete: if isOwner();
      allow create: if isOwner()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
