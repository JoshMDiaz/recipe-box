rules_version = '2';

// Each user's recipes live at users/{uid}/recipes, and only that signed-in
// user can read or write them. Writes are also shape-checked.
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidRecipe(data) {
      return data.keys().hasOnly(['title', 'description', 'servings', 'totalTime',
                                  'ingredients', 'steps', 'tags', 'imageUrl',
                                  'sourceText', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.ingredients is list && data.ingredients.size() <= 200
        && data.steps is list && data.steps.size() <= 200
        && data.tags is list && data.tags.size() <= 30
        && (!('sourceText' in data) || data.sourceText.size() <= 50000)
        // Photos are stored inline as data URLs; matches MAX_IMAGE_URL_LENGTH in image.ts.
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 250000));
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/recipes/{recipeId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && isValidRecipe(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner(uid)
        && isValidRecipe(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
